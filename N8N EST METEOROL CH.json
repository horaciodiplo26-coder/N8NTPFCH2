    {
      "parameters": {
        "jsCode": "const estado = $getWorkflowStaticData('global');\nconst hechas = estado.lecturasEmisoras || 0;\nconst data = $input.first().json;\nconst sensores = (data.sensores && data.sensores.datosSensores) || [];\nconst valor = (nombre) => {\n  const s = sensores.find((x) => x.nombreSensor === nombre);\n  if (!s) return '';\n  const n = parseFloat(s.valor);\n  return isNaN(n) ? '' : n;\n};\nconst lectura = hechas + 1;\nestado.lecturasEmisoras = lectura;\nconst actual = {\n  fecha: (data.sensores && data.sensores.fechaUltimaActualizacionDatos) || '',\n  temperatura: valor('Temperatura de Aire exterior'),\n  humedad: valor('Humedad de Aire exterior'),\n  lluvia: valor('Lluvia Caida'),\n  viento: valor('Vel. Viento'),\n  sensacion: valor('Sensación Térmica'),\n  lectura: lectura,\n};\nconst informe = [\n  'Estado del tiempo en Chivilcoy (estación INTA - Municipalidad)',\n  'Datos actualizados: ' + actual.fecha,\n  '',\n  'Temperatura: ' + actual.temperatura + ' °C',\n  'Sensación térmica: ' + actual.sensacion + ' °C',\n  'Humedad: ' + actual.humedad + ' %',\n  'Viento: ' + actual.viento + ' km/h',\n  'Lluvia caída: ' + actual.lluvia + ' mm',\n].join('\\n');\nreturn [{ json: Object.assign({}, actual, { informe: informe }) }];"
      },
